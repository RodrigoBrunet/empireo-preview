# Configuração do servidor (Apache) para o site oficial www.empireoengenharia.com.br
# Vale para HostGator e KingHost. Vai junto no build (public/ -> raiz do site).

# Sem listagem das pastas do servidor
Options -Indexes

# --- HTTPS + www: qualquer acesso (http://, sem www) vai para https://www.
# Ativar o SSL (AutoSSL/Let's Encrypt) no painel ANTES de publicar, senão o site não abre.
# Se usar Cloudflare, deixar o SSL dela no modo "Full" (com "Flexible" vira um loop).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.empireoengenharia.com.br%{REQUEST_URI} [L,R=301]
</IfModule>

# Página "não encontrada" do próprio site
ErrorDocument 404 /404.html

# --- Cabeçalhos de segurança
<IfModule mod_headers.c>
  # Força HTTPS no navegador por 1 ano
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Impede que outro site exiba este dentro de um frame (golpe de "site clonado")
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # --- Cache: CSS/JS do Next têm nome com hash (mudam a cada build) -> 1 ano;
  # imagens e ícones -> 30 dias; HTML sempre revalidado (mudanças aparecem na hora)
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compressão (site mais leve para baixar)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
